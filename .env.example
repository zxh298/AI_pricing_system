# Copy to .env (gitignored). Same variable names are used on GCP (Secret Manager / Cloud Run env).
WAREHOUSE=duckdb                 # duckdb | bigquery
DUCKDB_PATH=data/warehouse.duckdb
BIGQUERY_DATASET=                # used when WAREHOUSE=bigquery
DATABASE_URL=postgresql://pricing:pricing@localhost:5432/pricing
SAP_BASE_URL=http://localhost:8001   # host jobs; containers use service names
AUTH_MODE=none                   # none | iam
LLM_PROVIDER=scripted            # scripted | anthropic
ANTHROPIC_API_KEY=
SAP_READ_KEY=dev-read-key
SAP_WRITE_KEY=dev-write-key
SAP_SCHEMA=sap                   # Postgres schema owned by mock-sap
PIPELINE_SCHEMA=pipeline         # Postgres schema for weekly-pipeline run state
# mock-sap fault injection (off by default)
SAP_FAULT_FAIL_FIRST_N=0
SAP_FAULT_429_RATE=0
SAP_FAULT_5XX_RATE=0
SAP_FAULT_SEED=1
SAP_FAULT_RETRY_AFTER=1
